# Copy to `.env` for local dev (`pnpm dev`). In production these are set in the
# host's dashboard (Netlify env vars / `wrangler secret put`), never committed.

# REQUIRED in production. Must be byte-for-byte identical to the backend's
# PROXY_SECRET so signatures the backend mints verify here. If left blank the
# proxy runs in OPEN mode (no signature required) — dev only, never deploy that.
NITRO_PROXY_SECRET=

# Fallback User-Agent when a signed request doesn't pin one. Optional.
# NITRO_DEFAULT_USER_AGENT=Mozilla/5.0 (...)
